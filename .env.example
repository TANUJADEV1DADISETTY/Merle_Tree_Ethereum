# ============================================================
#  Ethereum Merkle Tree – Environment Variables
# ============================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# ------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------

# Full Ethereum JSON-RPC URL from Alchemy or Infura.
#
# Alchemy  → https://eth-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
# Infura   → https://mainnet.infura.io/v3/<YOUR_PROJECT_ID>
#
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# ------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------

# Ethereum block to fetch.
# Use an integer block number or the string "latest".
# Leave as "latest" to always fetch the newest block.
# Set to a historical number to trigger Extension D.
# Example: ETH_BLOCK_NUMBER=19000000
ETH_BLOCK_NUMBER=latest

# Index of the transaction (within the block) to prove inclusion for.
# Defaults to 0 (the first transaction).
ETH_TX_INDEX=0
